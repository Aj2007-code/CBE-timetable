# Add these in Vercel -> Project Settings -> Environment Variables (then redeploy).
# Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # already used by pyq/books admin
SESSION_LOG_URL=https://script.google.com/macros/s/XXXX/exec
SPI_SHEET_URL=https://script.google.com/macros/s/YYYY/exec
ADMIN_PASSWORD=your-admin-password
ADMIN_TOKEN_SECRET=long-random-string
GROQ_API_KEY=...
VOYAGE_API_KEY=...
